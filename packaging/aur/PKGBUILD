# Maintainer: Omar Daniels
pkgname=ceedee-ripper
pkgver=1.1.0
pkgrel=1
pkgdesc="Linux desktop app for extracting audio CDs to FLAC, MP3, WAV, or Ogg Vorbis"
arch=('x86_64')
url="https://github.com/odioski/CeeDee-Ripper"
license=('MIT')
depends=(
  'cdparanoia'
  'cd-discid'
  'eject'
  'flac'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-ugly'
  'lame'
  'libdiscid'
  'vorbis-tools'
)
makedepends=(
  'cargo'
  'git'
  'gtk4'
  'libadwaita'
  'pkgconf'
)
source=("${pkgname}::git+https://github.com/odioski/CeeDee-Ripper.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "${pkgname}"
  cargo build --release
}

check() {
  cd "${pkgname}"
  cargo test --locked
  cargo test --locked --features gtk-ui
}

package() {
  cd "${pkgname}"

  install -Dm755 "target/release/ceedee-ripper" \
    "${pkgdir}/usr/bin/ceedee-ripper"
  install -Dm644 "resources/ceedee-ripper.desktop" \
    "${pkgdir}/usr/share/applications/ceedee-ripper.desktop"
  install -Dm644 "resources/images/ceedee-ripper.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/io.github.odioski.ceedee_ripper.png"
  install -Dm644 "resources/metainfo/io.github.odioski.ceedee_ripper.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github.odioski.ceedee_ripper.metainfo.xml"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
